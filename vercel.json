{
  "version": 2,
  "framework": null,
  "buildCommand": "mkdir -p public && cp -r client/. public/",
  "outputDirectory": "public",
  "installCommand": "echo skip",
  "rewrites": [
    { "source": "/((?!css/|js/|images/|fonts/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
